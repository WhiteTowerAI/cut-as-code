{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-recut.local/schemas/subject-tracks.v1.json",
  "title": "Open-Recut Subject Tracks",
  "description": "Stable subject position interchange format for video-subject-detect.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "video",
    "coordinate_space",
    "producer",
    "frames",
    "tracks"
  ],
  "properties": {
    "schema_version": {
      "const": "subject-tracks.v1"
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "width", "height", "fps", "duration_s"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "coordinate_space": {
      "const": "source_pixels"
    },
    "producer": {
      "type": "object",
      "additionalProperties": true,
      "required": ["skill"],
      "properties": {
        "skill": {
          "const": "video-subject-detect"
        },
        "detector": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        }
      }
    },
    "frames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/frame"
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_s", "frame_index", "subjects"],
      "properties": {
        "time_s": {
          "type": "number",
          "minimum": 0
        },
        "frame_index": {
          "type": "integer",
          "minimum": 0
        },
        "subjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subject"
          }
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "track_id",
        "class",
        "bbox",
        "bbox_kind",
        "confidence"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "track_id": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "const": "person"
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "bbox_kind": {
          "enum": ["full_body", "upper_body"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track_id",
        "class",
        "start_s",
        "end_s",
        "num_observations",
        "mean_confidence",
        "coverage"
      ],
      "properties": {
        "track_id": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "const": "person"
        },
        "start_s": {
          "type": "number",
          "minimum": 0
        },
        "end_s": {
          "type": "number",
          "minimum": 0
        },
        "num_observations": {
          "type": "integer",
          "minimum": 1
        },
        "mean_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
