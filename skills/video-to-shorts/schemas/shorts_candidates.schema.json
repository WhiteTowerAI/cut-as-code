{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-recut.local/schemas/video-to-shorts/shorts-candidates.v1.json",
  "title": "Open-Recut Shorts Candidates",
  "description": "Reviewable LLM-selected candidate moments for short-form clips.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "video",
    "transcript",
    "producer",
    "selection",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "shorts-candidates.v1"
    },
    "video": {
      "$ref": "#/$defs/video"
    },
    "transcript": {
      "$ref": "#/$defs/transcript_source"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "selection": {
      "$ref": "#/$defs/selection"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "duration_s"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        },
        "kind": {
          "enum": ["rough_cut", "source"]
        }
      }
    },
    "transcript_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "timebase"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "timebase": {
          "enum": ["input_video_relative"]
        },
        "source": {
          "enum": ["provided", "rough_cut_selfcheck", "generated_by_whisper"]
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": true,
      "required": ["skill", "created_at"],
      "properties": {
        "skill": {
          "const": "video-to-shorts"
        },
        "created_at": {
          "type": "string"
        },
        "llm_provider": {
          "type": "string"
        },
        "llm_model": {
          "type": "string"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_count", "target_aspect_ratio", "duration_range_s"],
      "properties": {
        "target_count": {
          "type": "integer",
          "minimum": 1
        },
        "target_aspect_ratio": {
          "const": "9:16"
        },
        "duration_range_s": {
          "$ref": "#/$defs/duration_range"
        },
        "content_type": {
          "type": "string"
        },
        "density": {
          "enum": ["low", "medium", "high"]
        }
      }
    },
    "duration_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "title",
        "start_time",
        "end_time",
        "duration",
        "score",
        "hook_sentence",
        "virality_reason",
        "transcript_excerpt",
        "review_status"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "start_time": {
          "type": "number",
          "minimum": 0
        },
        "end_time": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "hook_sentence": {
          "type": "string"
        },
        "virality_reason": {
          "type": "string"
        },
        "source_excerpt": {
          "type": "string"
        },
        "transcript_excerpt": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_status": {
          "enum": ["candidate", "approved", "rejected"]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
