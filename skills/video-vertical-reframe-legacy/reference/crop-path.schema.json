{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-recut.local/schemas/vertical-reframe/crop-path.v1.json",
  "title": "Open-Recut Vertical Crop Path",
  "description": "Time-sampled crop boxes and strategy annotations used by preview and production renderers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "video",
    "target",
    "source_plan",
    "producer",
    "samples"
  ],
  "properties": {
    "schema_version": {
      "const": "crop-path.v1"
    },
    "video": {
      "$ref": "#/$defs/video"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "source_plan": {
      "$ref": "#/$defs/source_plan"
    },
    "producer": {
      "type": "object",
      "additionalProperties": true,
      "required": ["skill", "created_at"],
      "properties": {
        "skill": {
          "const": "video-vertical-reframe"
        },
        "created_at": {
          "type": "string"
        },
        "planner": {
          "type": "string"
        }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sample"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "width", "height", "fps", "duration_s"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect_ratio", "width", "height", "coordinate_space"],
      "properties": {
        "aspect_ratio": {
          "const": "9:16"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "coordinate_space": {
          "const": "source_pixels"
        },
        "background": {
          "enum": ["black", "blur", "source_fill"]
        }
      }
    },
    "source_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema_version"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "const": "reframe-plan.v1"
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_s",
        "frame_index",
        "segment_id",
        "scene_id",
        "strategy",
        "crop"
      ],
      "properties": {
        "time_s": {
          "type": "number",
          "minimum": 0
        },
        "frame_index": {
          "type": "integer",
          "minimum": 0
        },
        "segment_id": {
          "type": "string",
          "minLength": 1
        },
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "enum": ["TRACK", "LETTERBOX", "CENTER_FALLBACK"]
        },
        "crop": {
          "$ref": "#/$defs/crop"
        },
        "reason": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
