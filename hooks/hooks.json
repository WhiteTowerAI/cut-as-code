{
  "description": "Launch the Cut as Code Editor Hub without a model turn.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/launch-editor.cjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\hooks\\launch-editor.cjs\"",
            "timeout": 15,
            "statusMessage": "Opening Cut as Code Editor"
          }
        ]
      }
    ]
  }
}
